SQL queries in Accela scripts have specific rules.

// REQUIRED: Include SERV_PROV_CODE in all JOINs and WHERE clauses
sql += " INNER JOIN TABLE2 T2 ON T1.SERV_PROV_CODE = T2.SERV_PROV_CODE ";
sql += " WHERE T1.SERV_PROV_CODE = '$$ServProvCode$$' ";

// Build queries incrementally with proper formatting
var sql = "SELECT T1.FIELD1, T1.FIELD2 ";
sql += " FROM TABLE1 T1 ";
sql += " WHERE T1.SERV_PROV_CODE = '$$ServProvCode$$' ";

// Use $$paramName$$ format for parameters
var sql = "SELECT * FROM TABLE WHERE FIELD = '$$param$$' ";
sql = sql.replace("$$param$$", value);

// Standard execution pattern with logging and error handling
logMessage("Executing query: ", "DEBUG");
logMessage(formatSQL(sql), "DEBUG", "code");
var result = aa.db.select(sql, new Array());

if (!result.getSuccess()) {
    throw "Error executing SQL: " + result.getErrorMessage();
}

var output = result.getOutput();
if (output && output.size() > 0) {
    logMessage("Records Found: " + output.size(), "INFO");
}

