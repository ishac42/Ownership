---
description: Data health check helper
globs: 
alwaysApply: false
---
When creating data health checks, do the following:

1. Read the data health check architecture document [BATCH_EH_DATA_HEALTH.mdx](mdc:docs/solution-architecture/BATCH_EH_DATA_HEALTH.mdx)
2. Create the SQL file that contains the query for the data health check. This is for MSSQL. Please use [Account Status Misalignment.sql](mdc:Scripts/SQL/Data Health Checks/Account Status Misalignment.sql) as a template.
3. Add a new entry in the array in [EH_DATA_HEALTH_CHECKS.js](mdc:Scripts/EH Solutions/EH_DATA_HEALTH_CHECKS.js) to configure the data health check. 
    - Each health check as a name, description, enablehealthcheck flag, the SQL query, and an array of parameters.
    - The array of parameters are used to dynamically replace the parameters in the query, setting the $$parameter$$ = the value in the parameters array.
    - Use the SQL from the sql file created, but replace the parameters with the parameters in the array.

Example data health checks:
```
[{
        "Name": "Orphaned Time Entries",
        "Description": "Time accounting log entries in the database that are not found on any timesheets.",
        "EnableHealthCheck": "Y",
        "SQL": "SELECT G.time_group_name, TYPE.time_type_name, TTL.log_date, TTL.total_minutes, TTL.time_log_status, CASE WHEN LPER.b1_alt_id IS NULL THEN 'NA' ELSE LPER.b1_alt_id END AS B1_ALT_ID, TTL.billable_flag, TTL.time_log_seq, TTL.user_name, TTL.notation FROM t1_time_log TTL INNER JOIN r1_time_group G ON TTL.time_group_seq = G.time_group_seq INNER JOIN r1_time_types TYPE ON TTL.time_type_seq = TYPE.time_type_seq LEFT OUTER JOIN b1permit LPER ON LPER.serv_prov_code = TTL.serv_prov_code AND LPER.b1_per_id1 = TTL.b1_per_id1 AND LPER.b1_per_id2 = TTL.b1_per_id2 AND LPER.b1_per_id3 = TTL.b1_per_id3 WHERE TTL.serv_prov_code = '$$servProvCode$$' AND TTL.rec_status = 'A' AND TTL.log_date >= CONVERT (DATE, '$$fromDate$$', 101) AND TTL.log_date <= CONVERT (DATE, '$$toDate$$', 101) AND TTL.time_log_seq NOT IN (SELECT TSTAEID.attribute_value FROM b1permit PER INNER JOIN bappspectable_value TSTAEID ON TSTAEID.serv_prov_code = PER.serv_prov_code AND TSTAEID.b1_per_id1 = PER.b1_per_id1 AND TSTAEID.b1_per_id2 = PER.b1_per_id2 AND TSTAEID.b1_per_id3 = PER.b1_per_id3 AND TSTAEID.group_name = 'EH_TIME' AND TSTAEID.table_name = 'TIMESHEET ENTRIES' AND TSTAEID.column_name = 'Time Accounting Entry ID' AND PER.rec_status = 'A' AND PER.b1_appl_class = 'COMPLETE' WHERE PER.SERV_PROV_CODE = '$$servProvCode$$') ORDER BY TTL.log_date ASC",
        "Parameters": [{
                "Name": "$$servProvCode$$",
                "Value": "servProvCode"
            },
            {
                "Name": "$$fromDate$$",
                "Value": "05/01/2024"
            },
            {
                "Name": "$$toDate$$",
                "Value": "currentDate"
            }
        ]
    },
    {
        "Name": "Time Entries on Multiple Timesheets",
        "Description": "Time entries that exist on multiple timesheets.",
        "EnableHealthCheck": "Y",
        "SQL": "select a.b1_alt_id, b.ATTRIBUTE_VALUE, c.count_occurance, d.LOG_DATE, d.TIME_ELAPSED, d.USER_NAME from b1permit a join BAPPSPECTABLE_VALUE b on b.SERV_PROV_CODE = a.SERV_PROV_CODE and b.B1_PER_ID1 = a.b1_per_id1 and b.B1_PER_ID2 = a.B1_PER_ID2 and b.B1_PER_ID3 = a.B1_PER_ID3 join (select b.ATTRIBUTE_VALUE, count(*) count_occurance from b1permit a join BAPPSPECTABLE_VALUE b on b.SERV_PROV_CODE = a.SERV_PROV_CODE and b.B1_PER_ID1 = a.b1_per_id1 and b.B1_PER_ID2 = a.B1_PER_ID2 and b.B1_PER_ID3 = a.B1_PER_ID3 where column_name = 'Time Accounting Entry ID' and a.SERV_PROV_CODE = '$$servProvCode$$' group by b.ATTRIBUTE_VALUE having count(*) > 1) c on c.ATTRIBUTE_VALUE = b.ATTRIBUTE_VALUE join t1_time_log d on d.TIME_LOG_SEQ = b.ATTRIBUTE_VALUE where column_name = 'Time Accounting Entry ID' and a.SERV_PROV_CODE = '$$servProvCode$$' order by b.ATTRIBUTE_VALUE",
        "Parameters": [{
                "Name": "$$servProvCode$$",
                "Value": "servProvCode"
            }
        ]
    },
    {
        "Name": "Orphaned Records without an Account or Facility",
        "Description": "Orphaned Records (permits, service requests, etc) without an Account or Facility",
        "EnableHealthCheck": "Y",
        "SQL": "SELECT DISTINCT PER.B1_ALT_ID AS RECORD_ID, PER.B1_PER_GROUP AS RECORD_GROUP, PER.B1_PER_TYPE AS RECORD_TYPE, PER.B1_PER_SUB_TYPE AS RECORD_SUBTYPE, PER.B1_PER_CATEGORY AS RECORD_CATEGORY, PER.B1_APPL_STATUS AS RECORD_STATUS FROM B1PERMIT PER LEFT OUTER JOIN XAPP2REF XREC ON XREC.SERV_PROV_CODE = PER.SERV_PROV_CODE AND XREC.B1_PER_ID1 = PER.B1_PER_ID1 AND XREC.B1_PER_ID2 = PER.B1_PER_ID2 AND XREC.B1_PER_ID3 = PER.B1_PER_ID3 LEFT OUTER JOIN B1PERMIT PAR ON PAR.SERV_PROV_CODE = XREC.SERV_PROV_CODE AND PAR.B1_PER_ID1 = XREC.B1_MASTER_ID1 AND PAR.B1_PER_ID2 = XREC.B1_MASTER_ID2 AND PAR.B1_PER_ID3 = XREC.B1_MASTER_ID3 AND PAR.B1_PER_GROUP = 'EnvHealth' AND PAR.B1_PER_TYPE IN ('Facility', 'Account') AND PAR.B1_PER_SUB_TYPE = 'NA' AND PAR.B1_PER_CATEGORY = 'NA' AND PAR.REC_STATUS = 'A' WHERE PER.SERV_PROV_CODE = '$$servProvCode$$' AND PER.B1_PER_GROUP = 'EnvHealth' AND PER.REC_STATUS = 'A' AND PER.B1_APPL_STATUS NOT IN ($$excludedStatuses$$) AND PER.B1_PER_TYPE NOT IN ($$excludedTypes$$) AND PER.B1_PER_CATEGORY NOT IN ($$excludedCategories$$) AND PAR.B1_PER_ID1 IS NULL ORDER BY PER.B1_ALT_ID",
        "Parameters": [{
                "Name": "$$servProvCode$$",
                "Value": "servProvCode"
            },
            {
                "Name": "$$excludedTypes$$",
                "Value": "'Facility','Account','Event Information','Complaint','Consulation','Billing','Amendment','Temporary Event','Enforcement'"
            },
            {
                "Name": "$$excludedCategories$$",
                "Value": "'Application','Renewal'"
            },
            {
                "Name": "$$excludedStatuses$$",
                "Value": "'Pending','Void'"
            }
        ]
    },
    {
        "Name": "Accounts or Facilities with No Children",
        "Description": "Accounts or Facilities that have no child records (permits, service requests, etc)",
        "EnableHealthCheck": "Y",
        "SQL": "SELECT DISTINCT PER.B1_ALT_ID AS RECORD_ID, PER.B1_PER_GROUP AS RECORD_GROUP, PER.B1_PER_TYPE AS RECORD_TYPE, PER.B1_PER_SUB_TYPE AS RECORD_SUBTYPE, PER.B1_PER_CATEGORY AS RECORD_CATEGORY, PER.B1_APPL_STATUS AS RECORD_STATUS FROM B1PERMIT PER LEFT OUTER JOIN XAPP2REF XREC ON XREC.SERV_PROV_CODE = PER.SERV_PROV_CODE AND XREC.B1_MASTER_ID1 = PER.B1_PER_ID1 AND XREC.B1_MASTER_ID2 = PER.B1_PER_ID2 AND XREC.B1_MASTER_ID3 = PER.B1_PER_ID3 WHERE PER.SERV_PROV_CODE = '$$servProvCode$$' AND PER.B1_PER_GROUP = 'EnvHealth' AND PER.REC_STATUS = 'A' AND PER.B1_PER_TYPE IN ('Facility', 'Account') AND PER.B1_PER_SUB_TYPE = 'NA' AND PER.B1_PER_CATEGORY = 'NA' AND PER.B1_APPL_STATUS NOT IN ($$excludedStatuses$$) AND XREC.B1_PER_ID1 IS NULL ORDER BY PER.B1_ALT_ID",
        "Parameters": [{
                "Name": "$$servProvCode$$",
                "Value": "servProvCode"
            },
            {
                "Name": "$$excludedStatuses$$",
                "Value": "'Pending','Void'"
            }
        ]
    },
    {
        "Name": "Account Status Misalignment",
        "Description": "Accounts and Facilities where the record status and account status ASI field don't match (e.g. active record with inactive account status)",
        "EnableHealthCheck": "Y",
        "SQL": "SELECT DISTINCT PER.B1_ALT_ID AS RECORD_ID, PER.B1_PER_GROUP AS RECORD_GROUP, PER.B1_PER_TYPE AS RECORD_TYPE, PER.B1_PER_SUB_TYPE AS RECORD_SUBTYPE, PER.B1_PER_CATEGORY AS RECORD_CATEGORY, PER.B1_APPL_STATUS AS RECORD_STATUS, ASI.B1_CHECKLIST_COMMENT AS ACCOUNT_STATUS FROM B1PERMIT PER LEFT JOIN BCHCKBOX ASI ON ASI.SERV_PROV_CODE = PER.SERV_PROV_CODE AND ASI.B1_PER_ID1 = PER.B1_PER_ID1 AND ASI.B1_PER_ID2 = PER.B1_PER_ID2 AND ASI.B1_PER_ID3 = PER.B1_PER_ID3 AND ASI.B1_CHECKBOX_DESC = 'Account Status' WHERE PER.SERV_PROV_CODE = '$$servProvCode$$' AND PER.B1_PER_GROUP = 'EnvHealth' AND PER.B1_PER_TYPE IN ('Account', 'Facility') AND PER.B1_PER_SUB_TYPE = 'NA' AND PER.B1_PER_CATEGORY = 'NA' AND ((PER.B1_APPL_STATUS IN ($$activeRecordStatuses$$) AND ASI.B1_CHECKLIST_COMMENT NOT IN ($$activeAccountStatuses$$)) OR (PER.B1_APPL_STATUS NOT IN ($$activeRecordStatuses$$) AND ASI.B1_CHECKLIST_COMMENT IN ($$activeAccountStatuses$$))) ORDER BY PER.B1_ALT_ID",
        "Parameters": [{
                "Name": "$$servProvCode$$",
                "Value": "servProvCode"
            },
            {
                "Name": "$$activeRecordStatuses$$",
                "Value": "'Active'"
            },
            {
                "Name": "$$activeAccountStatuses$$",
                "Value": "'Active','Pending'"
            }
        ]
    }
]
```
